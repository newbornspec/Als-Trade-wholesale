{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://als-trade-wholesale-production.up.railway.app; connect-src 'self' https://als-trade-wholesale-production.up.railway.app; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://als-trade-wholesale-production.up.railway.app/sitemap.xml"
    },

    {
      "source": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|slackbot|slack-imgproxy|telegrambot|discordbot|pinterest|redditbot|applebot|bingbot|skypeuripreview|vkshare|embedly|flipboard|tumblr|mastodon|bluesky|quora link preview).*" }],
      "destination": "https://als-trade-wholesale-production.up.railway.app/prerender"
    },
    {
      "source": "/available-stock",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|slackbot|slack-imgproxy|telegrambot|discordbot|pinterest|redditbot|applebot|bingbot|skypeuripreview|vkshare|embedly|flipboard|tumblr|mastodon|bluesky|quora link preview).*" }],
      "destination": "https://als-trade-wholesale-production.up.railway.app/prerender/available-stock"
    },
    {
      "source": "/available-stock/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|slackbot|slack-imgproxy|telegrambot|discordbot|pinterest|redditbot|applebot|bingbot|skypeuripreview|vkshare|embedly|flipboard|tumblr|mastodon|bluesky|quora link preview).*" }],
      "destination": "https://als-trade-wholesale-production.up.railway.app/prerender/available-stock/:slug"
    },
    {
      "source": "/sold-stock",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|slackbot|slack-imgproxy|telegrambot|discordbot|pinterest|redditbot|applebot|bingbot|skypeuripreview|vkshare|embedly|flipboard|tumblr|mastodon|bluesky|quora link preview).*" }],
      "destination": "https://als-trade-wholesale-production.up.railway.app/prerender/sold-stock"
    },
    {
      "source": "/how-it-works",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|slackbot|slack-imgproxy|telegrambot|discordbot|pinterest|redditbot|applebot|bingbot|skypeuripreview|vkshare|embedly|flipboard|tumblr|mastodon|bluesky|quora link preview).*" }],
      "destination": "https://als-trade-wholesale-production.up.railway.app/prerender/how-it-works"
    },
    {
      "source": "/about-us",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|slackbot|slack-imgproxy|telegrambot|discordbot|pinterest|redditbot|applebot|bingbot|skypeuripreview|vkshare|embedly|flipboard|tumblr|mastodon|bluesky|quora link preview).*" }],
      "destination": "https://als-trade-wholesale-production.up.railway.app/prerender/about-us"
    },
    {
      "source": "/contact",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|slackbot|slack-imgproxy|telegrambot|discordbot|pinterest|redditbot|applebot|bingbot|skypeuripreview|vkshare|embedly|flipboard|tumblr|mastodon|bluesky|quora link preview).*" }],
      "destination": "https://als-trade-wholesale-production.up.railway.app/prerender/contact"
    },

    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
